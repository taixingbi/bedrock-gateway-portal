# Base URL of the deployed gateway's JWT route (bedrock-gateway-infra's
# api_gateway_url output) -- NOT the /iam/* SigV4 route, admin calls go
# out as a Bearer JWT. No trailing slash.
GATEWAY_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Cognito Hosted UI (bedrock-gateway-infra's cognito_idp module
# outputs: hosted_ui_domain, client_id, client_secret). Human sign-in
# only -- service/application callers use IAM/SigV4 against the
# gateway directly and need none of this.
COGNITO_DOMAIN=gateway-dev-portal-xxxxxxxxxxxx.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# This portal's own externally-reachable base URL -- used to build the
# OAuth2 redirect_uri (must exactly match a callback URL registered on
# the Cognito app client) and the post-logout redirect. No trailing
# slash.
PORTAL_BASE_URL=http://localhost:3000

# Set to "true" once the portal is served over HTTPS -- until then,
# session cookies are deliberately NOT marked Secure (browsers
# silently drop Secure cookies over plain HTTP).
PORTAL_HTTPS=false
